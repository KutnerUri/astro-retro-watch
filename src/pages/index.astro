---
import Analytics from '../components/Analytics.astro';
import { PLANETS, activeAt, nextAfter } from '../lib/retro';
import { DASH } from '../lib/chart';
import { nextText, nowText } from '../lib/dates';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(base, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const title = 'Retro Watch: Planetary Retrograde Calendar and Overlap Chart';
const description =
  'Mercury, Venus, Mars, Jupiter, Saturn, Uranus and Neptune retrograde dates, and when their retrogrades overlap, across the years and months ahead.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Retro Watch',
  url: canonical,
  description,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT',
  sameAs: 'https://github.com/KutnerUri/astro-retro-watch',
};

// Plain-text dates in the static HTML (rebuilt daily) so search engines can read them.
// The page script refreshes them on load, in case the build is stale.
const now = Date.now();
const rows = PLANETS.map((planet) => ({
  planet,
  current: activeAt(planet, now),
  next: nextAfter(planet, now)!,
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#1a1a19" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Retro Watch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Retrograde overlap curve and per-planet retrograde timeline for the ten years around today" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="google-site-verification" content="c_65gtO5NzbmPFhvR7kkY-1wM0badmHUVpBmureBer8" />
    <Analytics />
  </head>
  <body>
    <main>
      <h1>Retro Watch</h1>

      <section>
        <h2>Years</h2>
        <div class="chart" id="chart-years"></div>
      </section>

      <section>
        <h2>Months</h2>
        <ul class="legend">
          {
            PLANETS.map((planet) => (
              <li>
                <svg width="22" height="10" aria-hidden="true">
                  <line x1="1" x2="21" y1="5" y2="5" stroke={`var(--planet-${planet.toLowerCase()})`} stroke-width="2" stroke-dasharray={DASH[planet]} />
                </svg>
                {planet}
              </li>
            ))
          }
        </ul>
        <div class="chart" id="chart-months"></div>
      </section>

      <footer class="dates">
        <h2>Retrograde dates</h2>
        <table>
          <thead>
            <tr><th>Planet</th><th>Now</th><th>Next retrograde</th></tr>
          </thead>
          <tbody>
            {
              rows.map(({ planet, current, next }) => (
                <tr data-planet={planet}>
                  <th scope="row">{planet}</th>
                  <td data-now>{nowText(current)}</td>
                  <td data-next>{nextText(next)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </footer>
    </main>

    <script>
      import { renderChart, renderWaves } from '../lib/chart';
      import { $today } from '../lib/store';
      import { activeAt, nextAfter, type Planet } from '../lib/retro';
      import { nextText, nowText } from '../lib/dates';

      const DAY = 86_400_000;
      const addMonths = (t: number, n: number) => {
        const d = new Date(t);
        return Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + n, d.getUTCDate());
      };
      const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

      const yearsEl = document.getElementById('chart-years')!;
      const monthsEl = document.getElementById('chart-months')!;

      function draw() {
        const today = $today.get().getTime();
        const monthsFrom = addMonths(today, -6);
        const monthsTo = addMonths(today, 6);

        renderChart(yearsEl, {
          from: addMonths(today, -60),
          to: addMonths(today, 60),
          today,
          step: DAY,
          highlight: [monthsFrom, monthsTo],
          hoverFormat: (d) => d.toLocaleDateString(undefined, { month: 'long', year: 'numeric', timeZone: 'UTC' }),
          ticks: (from, to) => {
            const values: Date[] = [];
            for (let y = from.getUTCFullYear() + 1; y <= to.getUTCFullYear(); y++) values.push(new Date(Date.UTC(y, 0, 1)));
            const every = yearsEl.clientWidth < 600 ? 2 : 1;
            return { values, format: (d) => (d.getUTCFullYear() % every ? '' : String(d.getUTCFullYear())) };
          },
        });

        renderWaves(monthsEl, {
          from: monthsFrom,
          to: monthsTo,
          today,
          hoverFormat: (d) => d.toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }),
          ticks: (from, to) => {
            const values: Date[] = [];
            for (let m = Date.UTC(from.getUTCFullYear(), from.getUTCMonth() + 1, 1); m <= to.getTime(); m = addMonths(m, 1)) values.push(new Date(m));
            const narrow = monthsEl.clientWidth < 600;
            return {
              values,
              format: (d) => {
                const m = d.getUTCMonth();
                if (m === 0) return String(d.getUTCFullYear());
                return narrow && m % 2 ? '' : MONTH_NAMES[m];
              },
            };
          },
        });
      }

      function updateTable() {
        const t = $today.get().getTime();
        for (const row of document.querySelectorAll<HTMLTableRowElement>('.dates tr[data-planet]')) {
          const planet = row.dataset.planet as Planet;
          row.querySelector('[data-now]')!.textContent = nowText(activeAt(planet, t));
          row.querySelector('[data-next]')!.textContent = nextText(nextAfter(planet, t)!);
        }
      }

      $today.subscribe(() => {
        draw();
        updateTable();
      });
      let last = yearsEl.clientWidth;
      new ResizeObserver(() => {
        if (yearsEl.clientWidth !== last) {
          last = yearsEl.clientWidth;
          draw();
        }
      }).observe(yearsEl);
    </script>

    <style is:global>
      :root {
        color-scheme: light;
        --surface: #fcfcfb;
        --text-primary: #0b0b0b;
        --text-secondary: #52514e;
        --text-muted: #8a8984;
        --grid: #e8e7e3;
        --highlight: #f0efec;
        --planet-mercury: #2a78d6;
        --planet-venus: #eb6834;
        --planet-mars: #1baf7a;
        --planet-jupiter: #eda100;
        --planet-saturn: #e87ba4;
        --planet-uranus: #008300;
        --planet-neptune: #6250d6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: dark;
          --surface: #1a1a19;
          --text-primary: #f0efec;
          --text-secondary: #c3c2b7;
          --text-muted: #8f8e88;
          --grid: #2c2c2a;
          --highlight: #262624;
          --planet-mercury: #3987e5;
          --planet-venus: #d95926;
          --planet-mars: #199e70;
          --planet-jupiter: #c98500;
          --planet-saturn: #d55181;
          --planet-uranus: #0ca30c;
          --planet-neptune: #9085e9;
        }
      }
      body {
        margin: 0;
        background: var(--surface);
        color: var(--text-primary);
        font: 15px/1.5 system-ui, sans-serif;
      }
      main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
      h1 { margin: 0 0 4px; font-size: 28px; }
      h2 { margin: 32px 0 4px; font-size: 18px; }
      .chart { position: relative; width: 100%; }
      .chart svg { display: block; font-size: 11px; touch-action: pan-y; }
      .tick { fill: var(--text-muted); }
      .row-label { fill: var(--text-secondary); font-size: 12px; }
      .grid { stroke: var(--grid); }
      .baseline { stroke: var(--text-muted); }
      .row-track { stroke: var(--grid); }
      .highlight { fill: var(--highlight); }
      .curve-area { fill: var(--text-secondary); opacity: 0.12; }
      .curve-line { fill: none; stroke: var(--text-primary); stroke-width: 2; stroke-linejoin: round; }
      .today { stroke: var(--text-primary); stroke-width: 1.5; }
      .today-label { fill: var(--text-primary); font-weight: 600; }
      .crosshair { stroke: var(--text-muted); stroke-dasharray: 3 3; }
      .crosshair-dot { fill: var(--text-primary); stroke: var(--surface); stroke-width: 2; }
      .tooltip {
        position: absolute; pointer-events: none; z-index: 1;
        background: var(--surface); border: 1px solid var(--grid); border-radius: 6px;
        box-shadow: 0 2px 8px rgb(0 0 0 / 0.12); padding: 8px 10px; font-size: 12px; white-space: nowrap;
      }
      .tip-date { font-weight: 600; }
      .tip-value { color: var(--text-secondary); margin-bottom: 4px; }
      .tip-row { display: flex; align-items: center; gap: 6px; }
      .tip-dates { color: var(--text-muted); margin-left: auto; padding-left: 12px; }
      .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; }
      .tip-row .swatch { margin-right: 0; }
      .dates { margin-top: 56px; padding-top: 16px; border-top: 1px solid var(--grid); color: var(--text-muted); font-size: 12px; }
      .dates h2 { margin: 0 0 6px; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; }
      .dates table { border-collapse: collapse; }
      .dates th, .dates td { text-align: left; font-weight: 400; padding: 2px 20px 2px 0; }
      .dates thead th { font-size: 11px; opacity: 0.8; }
      .legend { display: flex; flex-wrap: wrap; gap: 4px 16px; list-style: none; padding: 0; margin: 0 0 4px; font-size: 13px; color: var(--text-secondary); }
      .legend li { display: flex; align-items: center; gap: 6px; }
      .wave { fill: none; stroke-width: 2; stroke-linejoin: round; }
      .wave-label { fill: var(--text-secondary); font-size: 11px; paint-order: stroke; stroke: var(--surface); stroke-width: 4px; stroke-linejoin: round; }
      .leader { stroke: var(--grid); }
      .wave-dot { stroke: var(--surface); stroke-width: 2; }
    </style>
  </body>
</html>
