---
import Analytics from '../components/Analytics.astro';
import RetroCharts from '../components/RetroCharts.astro';
import OrbitMap from '../components/OrbitMap.astro';
import Starfield from '../components/Starfield.astro';
import '../styles/base.css';
import { PLANETS, activeAt, dataRange } from '../lib/retro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(base, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;

// Title and description answer "what's retrograde right now?" as of the build. The site rebuilds daily (03:00 UTC).
const now = Date.now();
const retro = PLANETS.filter((p) => activeAt(p, now));
const list = (names: readonly string[]) => (names.length < 2 ? names.join('') : `${names.slice(0, -1).join(', ')} and ${names.at(-1)}`);
const title =
  retro.length === 0
    ? 'Retro Watch: no planets retrograding right now'
    : `Retro Watch: ${retro.length} planet${retro.length === 1 ? '' : 's'} retrograding right now`;
const nowText =
  retro.length === 0
    ? 'No planet is retrograde right now.'
    : `Right now ${list(retro)} ${retro.length === 1 ? 'is' : 'are'} retrograde${
        retro.includes('Mercury') ? '.' : '; Mercury is not.'
      }`;
const description = `${nowText} Retrograde dates for all seven planets, and when they overlap.`;

const dataUrl = new URL(`${base}retrogrades.json`, Astro.site).href;
const app = {
  '@type': 'WebApplication',
  name: 'Retro Watch',
  url: canonical,
  description,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT',
  sameAs: 'https://github.com/KutnerUri/astro-retro-watch',
};
// The retrograde periods as a dataset (eligible for Google Dataset Search).
const dataset = {
  '@type': 'Dataset',
  name: 'Planetary retrograde periods',
  description:
    `Start and end times (UTC) of every apparent retrograde period of Mercury, Venus, Mars, Jupiter, Saturn, Uranus and ` +
    `Neptune from ${dataRange[0]} to ${dataRange[1]}, with how many degrees each planet appears to move backwards. ` +
    'Computed from each planet\'s geocentric apparent ecliptic longitude with astronomy-engine, sampled daily and refined ' +
    'to about a minute at each turning point, and checked against Swiss Ephemeris times for 2013–2031.',
  url: canonical,
  keywords: ['retrograde', 'planetary retrograde', 'Mercury retrograde', 'ephemeris', 'astronomy', 'astrology'],
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  creator: { '@type': 'Person', name: 'KutnerUri', url: 'https://github.com/KutnerUri' },
  temporalCoverage: `${dataRange[0]}-01-01/${dataRange[1]}-12-31`,
  variableMeasured: ['Planet', 'Retrograde start (UTC)', 'Retrograde end (UTC)', 'Degrees of backward motion'],
  measurementTechnique: 'Ephemeris computation (astronomy-engine)',
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: dataUrl }],
};
const jsonLd = { '@context': 'https://schema.org', '@graph': [app, dataset] };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#07080d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Retro Watch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Retrograde overlap curve and per-planet retrograde timeline for the ten years around today" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="google-site-verification" content="c_65gtO5NzbmPFhvR7kkY-1wM0badmHUVpBmureBer8" />
    <Analytics />
  </head>
  <body>
    <Starfield />
    <main>
      <header class="masthead">
        <h1>Retro Watch</h1>
        <p class="tagline">When the planets seem to walk backwards,<br /> and when they do it together.</p>
      </header>

      <section class="orbit-section">
        <OrbitMap compact />
      </section>

      <RetroCharts />
    </main>
  </body>
</html>
