---
// Top-down map of the solar system: real planet positions (approximate orbital elements), a
// synthetic asteroid population, and short tails showing each planet's speed. Drawn in the browser, at the
// date the charts are focused on (`$focus`, set by dragging or ▶ Play) or else the shared `$today`.
---

<figure class="orbit-map">
  <div class="om-stage">
    <svg class="om-svg" viewBox="-100 -100 200 200" role="img" aria-label="Planet positions seen from above the solar system">
      <defs>
        <filter id="om-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="0.9" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
        <clipPath id="om-disc-clip"><circle r="1" /></clipPath>
        <!-- Jupiter, classic side view: grey poles, cream zones, the rust North and South Equatorial Belts. -->
        <linearGradient id="om-jupiter-bands" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#b9b0a0" />
          <stop offset="0.15" stop-color="#c9b79a" />
          <stop offset="0.25" stop-color="#ead9bb" />
          <stop offset="0.32" stop-color="#dcb08a" />
          <stop offset="0.37" stop-color="#eedfc2" />
          <stop offset="0.43" stop-color="#c27a45" />
          <stop offset="0.48" stop-color="#cf8a52" />
          <stop offset="0.52" stop-color="#f1e4cc" />
          <stop offset="0.58" stop-color="#f0e2c8" />
          <stop offset="0.63" stop-color="#c98450" />
          <stop offset="0.68" stop-color="#d39a68" />
          <stop offset="0.73" stop-color="#ecdcc0" />
          <stop offset="0.82" stop-color="#d8b994" />
          <stop offset="0.9" stop-color="#c8b9a2" />
          <stop offset="1" stop-color="#b5ab9a" />
        </linearGradient>
        <!-- Saturn: smooth butterscotch with barely-there bands. -->
        <linearGradient id="om-saturn-bands" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#cdbf9c" />
          <stop offset="0.2" stop-color="#e2d3ac" />
          <stop offset="0.4" stop-color="#ebdebb" />
          <stop offset="0.5" stop-color="#eee2c2" />
          <stop offset="0.6" stop-color="#e6d7b1" />
          <stop offset="0.78" stop-color="#dccba3" />
          <stop offset="1" stop-color="#c8b996" />
        </linearGradient>
        <radialGradient id="om-limb">
          <stop offset="0.55" stop-color="#000" stop-opacity="0" />
          <stop offset="1" stop-color="#000" stop-opacity="0.15" />
        </radialGradient>
        <linearGradient id="om-night">
          <stop offset="0" stop-color="#fff" stop-opacity="0.45" />
          <stop offset="0.5" stop-color="#fff" stop-opacity="0" />
          <stop offset="0.6" stop-color="#000" stop-opacity="0" />
          <stop offset="1" stop-color="#000" stop-opacity="0.25" />
        </linearGradient>
      </defs>
      <g data-om="scale"></g>
      <g data-om="orbits"></g>
      <g data-om="belt"></g>
      <g data-om="tails"></g>
      <g data-om="sights"></g>
      <g data-om="bodies"></g>
    </svg>
    <div class="om-actions">
      <button class="help-btn" type="button" popovertarget="help-orbits" aria-label="How to read this map">?</button>
      <button class="om-play" data-om="play-live" type="button" aria-pressed="false" aria-label="Play: two days per second">
        <svg class="om-icon" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 1 L9 5 L2.5 9 Z" /></svg><span class="om-label">Play</span>
      </button>
    </div>
  </div>

  <div class="help-card" id="help-orbits" popover>
    <div class="help-head">
      <strong>What am I looking at?</strong>
      <button class="help-close" type="button" popovertarget="help-orbits" popovertargetaction="hide" aria-label="Close"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M2 2 L12 12 M12 2 L2 12" /></svg></button>
    </div>
    <ul>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><circle class="i-orbit" cx="16" cy="16" r="5" /><circle class="i-orbit" cx="16" cy="16" r="9.5" /><circle class="i-orbit" cx="16" cy="16" r="14" /><circle class="i-sun" cx="16" cy="16" r="2.4" /><circle class="i-dot" cx="22.7" cy="9.3" r="1.9" /></svg>
        <span><b>You’re hovering above the solar system.</b> Every planet is exactly where it is right now, though we’ve drawn each one in its classic side view.</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><rect class="i-ruler" x="2" y="11.5" width="28" height="10" rx="1.6" /><path class="i-ruler" d="M4.50 11.5 v5.5 M7.96 11.5 v3 M9.99 11.5 v3 M12.54 11.5 v3 M16.00 11.5 v5.5 M19.46 11.5 v3 M21.49 11.5 v3 M24.04 11.5 v3 M27.50 11.5 v5.5" /></svg>
        <span><b>Distance is on a <a href="https://en.wikipedia.org/wiki/Logarithmic_scale" target="_blank" rel="noopener">logarithmic scale</a>.</b> (Space is absurdly big)</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><circle class="i-sun" cx="16" cy="16" r="14.5" /><circle class="i-hole" cx="8.15" cy="16" r="3.3" /><circle class="i-hole" cx="18.05" cy="16" r="2.6" /><circle class="i-ring" cx="18.05" cy="16" r="4.30" /><circle class="i-hole" cx="25.90" cy="16" r="1.25" /></svg>
        <span><b>Planets are drawn bigger.</b> Compared to the distance between them, they’d be too small to see, even on a logarithmic scale.</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><path class="i-path" d="M8 23 L24 9" /><circle class="i-earth" cx="7" cy="24" r="2.6" /><circle class="i-dot" cx="25" cy="8" r="3" /></svg>
        <span><b>Dashed lines</b> show retrogrades.</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><g class="i-rock"><circle cx="25.8" cy="16.0" r="0.60" /><circle cx="27.2" cy="17.1" r="0.50" /><circle cx="26.3" cy="17.5" r="0.60" /><circle cx="27.6" cy="18.4" r="0.60" /><circle cx="26.5" cy="19.2" r="0.60" /><circle cx="25.3" cy="19.8" r="0.45" /><circle cx="26.4" cy="21.0" r="0.45" /><circle cx="25.3" cy="21.1" r="0.60" /><circle cx="25.9" cy="22.9" r="0.60" /><circle cx="24.5" cy="23.2" r="0.50" /><circle cx="23.4" cy="23.0" r="0.60" /><circle cx="23.9" cy="24.7" r="0.60" /><circle cx="23.0" cy="24.2" r="0.60" /><circle cx="21.8" cy="24.0" r="0.45" /><circle cx="21.9" cy="25.7" r="0.45" /><circle cx="20.5" cy="25.4" r="0.50" /><circle cx="20.5" cy="27.1" r="0.60" /><circle cx="19.0" cy="26.6" r="0.60" /><circle cx="18.4" cy="25.8" r="0.50" /><circle cx="17.7" cy="27.5" r="0.60" /><circle cx="17.1" cy="26.6" r="0.60" /><circle cx="16.2" cy="28.1" r="0.60" /><circle cx="14.8" cy="27.2" r="0.45" /><circle cx="14.3" cy="26.2" r="0.50" /><circle cx="13.2" cy="27.5" r="0.60" /><circle cx="12.9" cy="26.4" r="0.45" /><circle cx="12.3" cy="25.3" r="0.45" /><circle cx="11.1" cy="26.3" r="0.50" /><circle cx="10.8" cy="25.2" r="0.45" /><circle cx="9.0" cy="25.8" r="0.45" /><circle cx="9.2" cy="24.8" r="0.45" /><circle cx="9.1" cy="23.5" r="0.60" /><circle cx="7.5" cy="24.0" r="0.45" /><circle cx="7.6" cy="22.7" r="0.45" /><circle cx="7.8" cy="21.4" r="0.50" /><circle cx="6.3" cy="21.8" r="0.50" /><circle cx="6.7" cy="20.6" r="0.50" /><circle cx="4.9" cy="20.2" r="0.45" /><circle cx="5.6" cy="19.5" r="0.60" /><circle cx="6.3" cy="18.5" r="0.45" /><circle cx="4.6" cy="17.7" r="0.50" /><circle cx="5.4" cy="17.0" r="0.60" /><circle cx="3.9" cy="16.2" r="0.60" /><circle cx="4.8" cy="15.4" r="0.60" /><circle cx="5.9" cy="14.3" r="0.50" /><circle cx="4.6" cy="13.3" r="0.45" /><circle cx="5.6" cy="12.9" r="0.45" /><circle cx="6.7" cy="12.7" r="0.60" /><circle cx="5.7" cy="11.2" r="0.45" /><circle cx="6.8" cy="10.9" r="0.50" /><circle cx="6.3" cy="9.0" r="0.60" /><circle cx="7.4" cy="9.0" r="0.45" /><circle cx="8.4" cy="9.3" r="0.45" /><circle cx="8.0" cy="7.6" r="0.50" /><circle cx="9.1" cy="7.8" r="0.60" /><circle cx="9.0" cy="6.0" r="0.50" /><circle cx="10.3" cy="6.3" r="0.45" /><circle cx="11.3" cy="6.8" r="0.60" /><circle cx="11.8" cy="5.0" r="0.45" /><circle cx="12.8" cy="5.6" r="0.50" /><circle cx="13.8" cy="6.2" r="0.45" /><circle cx="14.6" cy="4.6" r="0.50" /><circle cx="15.4" cy="5.5" r="0.45" /><circle cx="16.3" cy="4.0" r="0.45" /><circle cx="16.9" cy="4.9" r="0.50" /><circle cx="17.8" cy="5.9" r="0.60" /><circle cx="18.4" cy="4.6" r="0.45" /><circle cx="19.0" cy="5.6" r="0.60" /><circle cx="19.8" cy="6.9" r="0.45" /><circle cx="21.0" cy="5.8" r="0.50" /><circle cx="21.4" cy="7.1" r="0.60" /><circle cx="22.5" cy="6.0" r="0.45" /><circle cx="22.6" cy="7.2" r="0.45" /><circle cx="22.9" cy="8.6" r="0.50" /><circle cx="24.4" cy="8.0" r="0.60" /><circle cx="24.3" cy="9.3" r="0.50" /><circle cx="26.2" cy="9.4" r="0.60" /><circle cx="25.7" cy="10.4" r="0.60" /><circle cx="25.2" cy="11.4" r="0.60" /><circle cx="27.1" cy="12.0" r="0.45" /><circle cx="26.3" cy="12.6" r="0.60" /><circle cx="25.7" cy="13.9" r="0.60" /><circle cx="27.3" cy="14.4" r="0.50" /><circle cx="26.5" cy="15.0" r="0.45" /></g></svg>
        <span><b>The asteroids are an approximation.</b> There are over a million out there, and we didn’t draw them all.</span>
      </li>
    </ul>
  </div>
</figure>

<style is:global>
  .orbit-map { margin: 0; }
  .om-stage { position: relative; max-width: 520px; margin: 4px auto 0; }
  .om-svg { display: block; width: 100%; aspect-ratio: 1; }
  .om-actions { position: absolute; right: 4px; bottom: 4px; display: flex; align-items: center; gap: 8px; }
  .om-play {
    display: flex; align-items: center; gap: 6px;
    font: 500 12px 'Jost', sans-serif; color: var(--starlight); background: var(--card);
    border: 1px solid var(--rule); border-radius: 999px; padding: 4px 12px; cursor: pointer;
  }
  .om-icon { display: block; width: 9px; height: 9px; fill: currentColor; }
  .om-orbit { fill: none; stroke: var(--rule); stroke-width: 0.25; }
  .om-scale-ring { fill: none; stroke: var(--grid); stroke-width: 0.2; stroke-dasharray: 0.6 1; }
  .om-sun { fill: var(--starlight); filter: url(#om-glow); }
  .om-rocks { fill: none; stroke: var(--text-muted); stroke-linecap: round; stroke-width: 0.42; opacity: 0.55; }
  .om-rocks.trojan { stroke: var(--planet-jupiter); opacity: 0.4; }
  .om-sight { stroke: var(--starlight); stroke-width: 0.25; stroke-dasharray: 0.8 0.8; opacity: 0.55; }
  .om-glyph { text-rendering: geometricPrecision; font-size: var(--om-label, 3.6px); font-family: 'Noto Sans Symbols', system-ui, sans-serif; dominant-baseline: central; }
</style>

<script>
  import { BODIES, position, periodDays, speedKms, type Body } from '../lib/orbits';
  import { asteroidPositions, type Kind } from '../lib/asteroids';
  import { GLYPH, activeAt, type Planet } from '../lib/retro';
  import { $focus, $today } from '../lib/store';

  const DAY = 86_400_000;
  const NS = 'http://www.w3.org/2000/svg';

  // Sizes: the Sun and the planets on one log scale of real equatorial radius (km). True sizes would be
  // specks next to the distances, so sizes get their own scale: Mercury (smallest) is pinned at 0.7 units and
  // the Sun at 5, and every ×10 in real radius adds the same amount in between.
  const RADIUS_KM: Record<Body | 'Sun', number> = {
    Sun: 695_700, Mercury: 2_440, Venus: 6_052, Earth: 6_371, Mars: 3_390,
    Jupiter: 69_911, Saturn: 58_232, Uranus: 25_362, Neptune: 24_622,
  };
  const MIN_SIZE = 0.7, SUN_SIZE = 5;
  const size = (b: Body | 'Sun') =>
    MIN_SIZE + ((SUN_SIZE - MIN_SIZE) * Math.log(RADIUS_KM[b] / RADIUS_KM.Mercury)) / Math.log(RADIUS_KM.Sun / RADIUS_KM.Mercury);

  const EARTH_SEA = '#2f74e0', EARTH_LAND = '#3fae5a';
  const colour = (b: Body) => (b === 'Earth' ? EARTH_SEA : `var(--planet-${b.toLowerCase()})`);
  const glyph = (b: Body) => (b === 'Earth' ? '⊕' : GLYPH[b]);
  const isRetro = (b: Body, t: number) => b !== 'Earth' && !!activeAt(b as Planet, t);

  // Distance: AU -> SVG units on a log scale that starts just outside the Sun's disc.
  const MIN_AU = 0.3, MAX_AU = 30.5, R_IN = 9, R_OUT = 92;
  const scale = (d: number) => R_IN + ((R_OUT - R_IN) * Math.log(d / MIN_AU)) / Math.log(MAX_AU / MIN_AU);

  for (const root of document.querySelectorAll<HTMLElement>('.orbit-map')) {
    const q = <T extends Element = SVGGElement>(name: string) => root.querySelector<T>(`[data-om="${name}"]`)!;
    const el = (tag: string, attrs: Record<string, string | number>, parent: Element) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      parent.appendChild(e);
      return e;
    };

    const toXY = (lon: number, r: number): [number, number] => {
      const R = scale(r);
      return [R * Math.cos(lon), -R * Math.sin(lon)]; // north-up view: anticlockwise motion
    };
    const at = (b: Body, t: number) => {
      const p = position(b, t);
      return toXY(p.lon, p.r);
    };

    let now = $today.get().getTime();

    // Distance rings (1, 5, 10, 20, 30 AU) and one full orbit per planet (the true, eccentric path).
    function drawStatic() {
      rocksAt = -Infinity;
      const scaleG = q('scale'), orbitsG = q('orbits');
      scaleG.replaceChildren();
      orbitsG.replaceChildren();
      for (const au of [1, 5, 10, 20, 30]) {
        el('circle', { class: 'om-scale-ring', r: scale(au) }, scaleG);
      }
      for (const b of BODIES) {
        const n = 240, P = periodDays(b) * DAY;
        const pts = Array.from({ length: n }, (_, i) => at(b, now + (i / n) * P));
        el('path', { class: 'om-orbit', d: `M${pts.map((p) => p.map((v) => v.toFixed(2)).join(' ')).join('L')}Z` }, orbitsG);
      }
    }

    function drawAsteroids(t: number) {
      const g = q('belt');
      g.replaceChildren();
      const paths: Record<Kind, string> = { belt: '', hilda: '', trojan: '' };
      for (const a of asteroidPositions(t)) {
        const [x, y] = toXY(a.lon, a.r);
        paths[a.kind] += `M${x.toFixed(2)} ${y.toFixed(2)}h0`; // zero-length segment + round cap = dot
      }
      el('path', { class: 'om-rocks', d: paths.belt + paths.hilda }, g);
      el('path', { class: 'om-rocks trojan', d: paths.trojan }, g);
    }

    // Tail: a thin line back along the orbit that fades out. Its length follows the planet's current
    // angular speed, compressed (speed^0.4) so the outer planets still show one.
    const REF_SPEED = 4.09; // Mercury's mean, degrees/day
    const angularSpeed = (b: Body, t: number) => {
      const d = position(b, t + DAY / 2).lon - position(b, t - DAY / 2).lon;
      return ((((d * 180) / Math.PI) % 360) + 360) % 360;
    };
    function tailPoints(b: Body, t: number) {
      const w = angularSpeed(b, t);
      const span = ((60 * (w / REF_SPEED) ** 0.4) / w) * DAY;
      const N = 32;
      return Array.from({ length: N + 1 }, (_, i) => at(b, t - (i / N) * span));
    }

    // Faces use the classic side-on look people recognise (like the blue-marble Earth). Unit-disc coordinates.
    function drawSurface(b: Body, g: Element) {
      switch (b) {
        case 'Mercury': // a few craters
          for (const [cx, cy, cr] of [[-0.35, -0.3, 0.2], [0.4, 0.1, 0.14], [-0.1, 0.5, 0.17], [0.25, -0.55, 0.1]])
            el('circle', { cx, cy, r: cr, fill: 'rgb(40 40 60 / 0.22)' }, g);
          break;
        case 'Earth': // the classic blue marble
          el('path', { d: 'M-0.75 -0.55Q-0.25 -1 0.15 -0.45Q0.05 0.05 -0.4 0.15Q-0.95 -0.05 -0.75 -0.55Z', fill: EARTH_LAND }, g);
          el('path', { d: 'M0.2 0.15Q0.7 -0.15 0.85 0.3Q0.6 0.95 0.2 0.7Q-0.05 0.4 0.2 0.15Z', fill: EARTH_LAND }, g);
          break;
        case 'Jupiter': // belts and zones, plus the Great Red Spot
          el('circle', { r: 1, fill: 'url(#om-jupiter-bands)' }, g);
          el('ellipse', { cx: 0.32, cy: 0.38, rx: 0.2, ry: 0.11, fill: '#c0603a', opacity: 0.85 }, g);
          break;
        case 'Saturn':
          el('circle', { r: 1, fill: 'url(#om-saturn-bands)' }, g);
          break;
        case 'Neptune': // deep blue, a dark storm and small bright clouds (as Voyager 2 saw it)
          el('circle', { r: 1, fill: '#1d36b8' }, g);
          el('ellipse', { cx: -0.1, cy: 0.08, rx: 0.26, ry: 0.12, fill: '#14206e', opacity: 0.55 }, g);
          for (const [cx, cy, rx, ry, o] of [[-0.12, -0.02, 0.15, 0.03, 0.8], [0.4, -0.5, 0.22, 0.025, 0.5], [-0.5, 0.55, 0.09, 0.03, 0.6], [0.2, 0.45, 0.07, 0.02, 0.5]])
            el('ellipse', { cx, cy, rx, ry, fill: '#e8f0ff', opacity: o }, g);
          break;
        // Venus, Mars and Uranus stay plain.
      }
    }

    // Rings. Each is an ellipse: `angle` turns its long axis (SVG degrees), `ratio` is short/long, and `nearSide`
    // says which half (in the turned frame) passes in front of the planet. Radii are in planet radii.
    // - Saturn: the classic tilted look, slimmed to the bright B ring and the dimmer A ring, with the Cassini
    //   Division between them (true radii 1.53–1.95 and 2.03–2.27, scaled down ~0.8 to keep it compact).
    // - Uranus: tilted as it really sits, seen from above. Its pole (IAU, J2000 ecliptic) is at λ 257.6°, β 7.7°,
    //   so the ring's long axis is perpendicular to λ 257.6° and its ratio is sin 7.7°: almost a line.
    //   The pole side tilts away from the viewer, so the half on the other side (y < 0) is the near one.
    interface Ring { angle: number; ratio: number; nearSide: 'up' | 'down'; bands: [number, number, string, number][] }
    const RINGS: Partial<Record<Body, Ring>> = {
      Saturn: {
        angle: -18, ratio: 0.32, nearSide: 'down',
        bands: [ // [mid radius, width, colour, opacity]
          [1.43, 0.36, '#d6d1d4', 0.75],
          [1.79, 0.2, '#aaa5b0', 0.6],
        ],
      },
      Uranus: { angle: -(257.6 + 90), ratio: 0.134, nearSide: 'up', bands: [[2.0, 0.035, '#e6f2f4', 0.35]] }, // the ε ring
    };
    const ringExtent = (b: Body) => Math.max(1, ...(RINGS[b]?.bands.map(([m, w]) => m + w / 2) ?? []));
    // Each ring is split in two: the far half is drawn before the planet (hidden behind it), the near half after.
    function drawRings(b: Body, g: Element, half: 'back' | 'front') {
      const ring = RINGS[b];
      if (!ring) return;
      // From (-rx, 0) to (rx, 0), sweep 1 runs through y < 0 ('up') and sweep 0 through y > 0 ('down').
      const up = (half === 'front') === (ring.nearSide === 'up');
      for (const [m, w, stroke, opacity] of ring.bands) {
        el('path', {
          d: `M${-m} 0A${m} ${m * ring.ratio} 0 0 ${up ? 1 : 0} ${m} 0`,
          fill: 'none', stroke, opacity, 'stroke-width': w, transform: `rotate(${ring.angle})`,
        }, g);
      }
    }

    // Planets are built once and then only moved: rebuilding ~190 elements every frame made playback judder.
    interface Parts { disc: Element; shade: Element; label: Element; title: Element; tail: Element; grad: Element; sight: Element }
    let parts: Record<Body, Parts> | null = null;
    // Labels sit on whole device pixels, so text moves in clean 1px steps instead of being re-rounded every frame.
    const mapSvg = root.querySelector<SVGSVGElement>('.om-svg')!;
    const snap = (v: number) => {
      const unitsPerPx = 200 / ((mapSvg.clientWidth || 200) * (window.devicePixelRatio || 1));
      return (Math.round(v / unitsPerPx) * unitsPerPx).toFixed(3);
    };
    const set = (e: Element, attrs: Record<string, string | number>) => {
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    };
    const fixed = (n: number) => n.toFixed(2);
    function buildBodies() {
      const tailsG = q('tails'), bodiesG = q('bodies'), sightsG = q('sights');
      tailsG.replaceChildren();
      bodiesG.replaceChildren();
      sightsG.replaceChildren();
      el('circle', { class: 'om-sun', r: size('Sun') }, bodiesG);
      parts = {} as Record<Body, Parts>;
      for (const b of BODIES) {
        const id = `om-tail-${b}`;
        const grad = el('linearGradient', { id, gradientUnits: 'userSpaceOnUse' }, tailsG);
        el('stop', { offset: 0, 'stop-color': colour(b), 'stop-opacity': 0.8 }, grad);
        el('stop', { offset: 1, 'stop-color': colour(b), 'stop-opacity': 0 }, grad);
        const tail = el('path', { fill: 'none', stroke: `url(#${id})`, 'stroke-width': 0.5, 'stroke-linecap': 'round' }, tailsG);
        const sight = el('line', { class: 'om-sight', visibility: 'hidden' }, sightsG);
        const g = el('g', {}, bodiesG);
        // Disc drawn in unit coordinates: base colour, surface detail, shading, then rings on top.
        const disc = el('g', {}, g);
        drawRings(b, disc, 'back');
        el('circle', { r: 1, fill: colour(b) }, disc);
        const surface = el('g', { 'clip-path': 'url(#om-disc-clip)' }, disc);
        drawSurface(b, surface);
        el('circle', { r: 1, fill: 'url(#om-limb)' }, disc);
        // Sunlit highlight toward the Sun, shade on the far side (rotated in draw so the dark end points away).
        const shade = el('circle', { r: 1, fill: 'url(#om-night)' }, disc);
        drawRings(b, disc, 'front');
        const label = el('text', { class: 'om-glyph', fill: colour(b) }, g);
        label.textContent = glyph(b);
        const title = el('title', {}, g);
        parts[b] = { disc, shade, label, title, tail, grad, sight };
      }
    }

    // Asteroids move under 0.6° a day, so during playback they only need redrawing a few times a second.
    let rocksAt = -Infinity;
    function draw() {
      const t = $focus.get() ?? now;
      if (!parts) buildBodies();
      if (Math.abs(t - rocksAt) >= DAY / 4) {
        drawAsteroids(t);
        rocksAt = t;
      }
      const earth = at('Earth', t);

      for (const b of BODIES) {
        const { disc, shade, label, title, tail, grad, sight } = parts![b];
        const pts = tailPoints(b, t);
        const end = pts[pts.length - 1];
        set(grad, { x1: fixed(pts[0][0]), y1: fixed(pts[0][1]), x2: fixed(end[0]), y2: fixed(end[1]) });
        tail.setAttribute('d', `M${pts.map((p) => p.map(fixed).join(' ')).join('L')}`);

        const p = position(b, t);
        const [x, y] = toXY(p.lon, p.r);
        const r = size(b);
        disc.setAttribute('transform', `translate(${fixed(x)} ${fixed(y)}) scale(${r})`);
        shade.setAttribute('transform', `rotate(${((Math.atan2(y, x) * 180) / Math.PI).toFixed(1)})`);
        set(label, { x: snap(x + r * ringExtent(b) + 1), y: snap(y) });

        const retroNow = isRetro(b, t);
        if (retroNow) set(sight, { x1: fixed(earth[0]), y1: fixed(earth[1]), x2: fixed(x), y2: fixed(y), visibility: 'visible' });
        else sight.setAttribute('visibility', 'hidden');
        title.textContent =
          `${b}: ${p.r.toFixed(2)} AU from the Sun, ${speedKms(b, p.r).toFixed(1)} km/s${retroNow ? ', retrograde from Earth' : ''}`;
      }
    }

    // Planet labels stay ~11px on screen whatever the map's size (SVG units shrink on narrow screens).
    new ResizeObserver(([entry]) => {
      const pxPerUnit = entry.contentRect.width / 200;
      if (pxPerUnit > 0) mapSvg.style.setProperty('--om-label', `${Math.max(3.6, 11 / pxPerUnit).toFixed(2)}px`);
    }).observe(mapSvg);

    setupPlayback();

    // ▶ Play: moves the shared focus date forward two days per second, so the map, the months chart and the
    // years window all follow. Stops by itself where the years chart ends (5 years ahead, minus half the
    // months window).
    function setupPlayback() {
      const btn = q<HTMLButtonElement>('play-live');
      const icon = btn.querySelector('.om-icon path')!;
      const label = btn.querySelector('.om-label')!;
      // SVG shapes rather than ▶/⏸ characters, whose glyphs sit at different heights in the line.
      const PLAY = 'M2.5 1 L9 5 L2.5 9 Z';
      const PAUSE = 'M2 1 H4.2 V9 H2 Z M5.8 1 H8 V9 H5.8 Z';
      const LAST = (60 - 4) * 30.44 * DAY;
      const DAYS_PER_SECOND = 2;
      let frame = 0, last = 0;
      const show = (playing: boolean) => {
        icon.setAttribute('d', playing ? PAUSE : PLAY);
        label.textContent = playing ? 'Pause' : 'Play';
        btn.setAttribute('aria-pressed', String(playing));
        btn.setAttribute('aria-label', playing ? 'Pause' : 'Play: two days per second');
      };
      const stop = () => {
        cancelAnimationFrame(frame);
        frame = 0;
        show(false);
      };
      const step = (ts: number) => {
        const dt = last ? ts - last : 0;
        last = ts;
        const next = ($focus.get() ?? now) + (dt / 1000) * DAYS_PER_SECOND * DAY;
        if (next > now + LAST) return stop();
        $focus.set(next);
        frame = requestAnimationFrame(step);
      };
      // "Back to today" clears the focus: stop rather than carry on from today.
      $focus.listen((v) => {
        if (frame && v === null) stop();
      });
      btn.addEventListener('click', () => {
        if (frame) return stop();
        last = 0;
        show(true);
        frame = requestAnimationFrame(step);
      });
    }
    // Follow the shared "today" (subscribe also fires once now, for the first draw), and the charts' focus
    // while the visitor drags it: at most one redraw per frame.
    $today.subscribe((d) => {
      now = d.getTime();
      drawStatic();
      draw();
    });
    let pending = false;
    $focus.listen(() => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        pending = false;
        draw();
      });
    });
  }
</script>
