---
// Top-down map of the solar system: real planet positions (approximate orbital elements), a
// synthetic asteroid population, and short tails showing each planet's speed. MapSvg renders it at build
// time; the script below moves it to the date the charts are focused on (`$focus`, set by dragging or ▶ Play)
// or else the shared `$today`.
import MapSvg from './MapSvg.astro';
---

<figure class="orbit-map">
  <div class="om-stage">
    <MapSvg class="om-svg" t={Date.now()} role="img" aria-label="Planet positions seen from above the solar system" />
    <div class="om-actions">
      <button class="help-btn" type="button" popovertarget="help-orbits" aria-label="How to read this map">?</button>
      <button class="om-play" data-om="play-live" type="button" aria-pressed="false" aria-label="Play: two days per second">
        <svg class="om-icon" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 1 L9 5 L2.5 9 Z" /></svg><span class="om-label">Play</span>
      </button>
    </div>
  </div>

  <div class="help-card" id="help-orbits" popover>
    <div class="help-head">
      <strong>What am I looking at?</strong>
      <button class="help-close" type="button" popovertarget="help-orbits" popovertargetaction="hide" aria-label="Close"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M2 2 L12 12 M12 2 L2 12" /></svg></button>
    </div>
    <ul>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><circle class="i-orbit" cx="16" cy="16" r="5" /><circle class="i-orbit" cx="16" cy="16" r="9.5" /><circle class="i-orbit" cx="16" cy="16" r="14" /><circle class="i-sun" cx="16" cy="16" r="2.4" /><circle class="i-dot" cx="22.7" cy="9.3" r="1.9" /></svg>
        <span><b>You’re hovering above the solar system.</b> Every planet is exactly where it is right now, though we’ve drawn each one in its classic side view.</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><rect class="i-ruler" x="2" y="11.5" width="28" height="10" rx="1.6" /><path class="i-ruler" d="M4.50 11.5 v5.5 M7.96 11.5 v3 M9.99 11.5 v3 M12.54 11.5 v3 M16.00 11.5 v5.5 M19.46 11.5 v3 M21.49 11.5 v3 M24.04 11.5 v3 M27.50 11.5 v5.5" /></svg>
        <span><b>Distance is on a <a href="https://en.wikipedia.org/wiki/Logarithmic_scale" target="_blank" rel="noopener">logarithmic scale</a>.</b> (Space is absurdly big)</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><circle class="i-sun" cx="16" cy="16" r="14.5" /><circle class="i-hole" cx="8.15" cy="16" r="3.3" /><circle class="i-hole" cx="18.05" cy="16" r="2.6" /><circle class="i-ring" cx="18.05" cy="16" r="4.30" /><circle class="i-hole" cx="25.90" cy="16" r="1.25" /></svg>
        <span><b>Planets are drawn bigger.</b> Compared to the distance between them, they’d be too small to see, even on a logarithmic scale.</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><path class="i-path" d="M8 23 L24 9" /><circle class="i-earth" cx="7" cy="24" r="2.6" /><circle class="i-dot" cx="25" cy="8" r="3" /></svg>
        <span><b>Dashed lines</b> show retrogrades.</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><g class="i-rock"><circle cx="25.8" cy="16.0" r="0.60" /><circle cx="27.2" cy="17.1" r="0.50" /><circle cx="26.3" cy="17.5" r="0.60" /><circle cx="27.6" cy="18.4" r="0.60" /><circle cx="26.5" cy="19.2" r="0.60" /><circle cx="25.3" cy="19.8" r="0.45" /><circle cx="26.4" cy="21.0" r="0.45" /><circle cx="25.3" cy="21.1" r="0.60" /><circle cx="25.9" cy="22.9" r="0.60" /><circle cx="24.5" cy="23.2" r="0.50" /><circle cx="23.4" cy="23.0" r="0.60" /><circle cx="23.9" cy="24.7" r="0.60" /><circle cx="23.0" cy="24.2" r="0.60" /><circle cx="21.8" cy="24.0" r="0.45" /><circle cx="21.9" cy="25.7" r="0.45" /><circle cx="20.5" cy="25.4" r="0.50" /><circle cx="20.5" cy="27.1" r="0.60" /><circle cx="19.0" cy="26.6" r="0.60" /><circle cx="18.4" cy="25.8" r="0.50" /><circle cx="17.7" cy="27.5" r="0.60" /><circle cx="17.1" cy="26.6" r="0.60" /><circle cx="16.2" cy="28.1" r="0.60" /><circle cx="14.8" cy="27.2" r="0.45" /><circle cx="14.3" cy="26.2" r="0.50" /><circle cx="13.2" cy="27.5" r="0.60" /><circle cx="12.9" cy="26.4" r="0.45" /><circle cx="12.3" cy="25.3" r="0.45" /><circle cx="11.1" cy="26.3" r="0.50" /><circle cx="10.8" cy="25.2" r="0.45" /><circle cx="9.0" cy="25.8" r="0.45" /><circle cx="9.2" cy="24.8" r="0.45" /><circle cx="9.1" cy="23.5" r="0.60" /><circle cx="7.5" cy="24.0" r="0.45" /><circle cx="7.6" cy="22.7" r="0.45" /><circle cx="7.8" cy="21.4" r="0.50" /><circle cx="6.3" cy="21.8" r="0.50" /><circle cx="6.7" cy="20.6" r="0.50" /><circle cx="4.9" cy="20.2" r="0.45" /><circle cx="5.6" cy="19.5" r="0.60" /><circle cx="6.3" cy="18.5" r="0.45" /><circle cx="4.6" cy="17.7" r="0.50" /><circle cx="5.4" cy="17.0" r="0.60" /><circle cx="3.9" cy="16.2" r="0.60" /><circle cx="4.8" cy="15.4" r="0.60" /><circle cx="5.9" cy="14.3" r="0.50" /><circle cx="4.6" cy="13.3" r="0.45" /><circle cx="5.6" cy="12.9" r="0.45" /><circle cx="6.7" cy="12.7" r="0.60" /><circle cx="5.7" cy="11.2" r="0.45" /><circle cx="6.8" cy="10.9" r="0.50" /><circle cx="6.3" cy="9.0" r="0.60" /><circle cx="7.4" cy="9.0" r="0.45" /><circle cx="8.4" cy="9.3" r="0.45" /><circle cx="8.0" cy="7.6" r="0.50" /><circle cx="9.1" cy="7.8" r="0.60" /><circle cx="9.0" cy="6.0" r="0.50" /><circle cx="10.3" cy="6.3" r="0.45" /><circle cx="11.3" cy="6.8" r="0.60" /><circle cx="11.8" cy="5.0" r="0.45" /><circle cx="12.8" cy="5.6" r="0.50" /><circle cx="13.8" cy="6.2" r="0.45" /><circle cx="14.6" cy="4.6" r="0.50" /><circle cx="15.4" cy="5.5" r="0.45" /><circle cx="16.3" cy="4.0" r="0.45" /><circle cx="16.9" cy="4.9" r="0.50" /><circle cx="17.8" cy="5.9" r="0.60" /><circle cx="18.4" cy="4.6" r="0.45" /><circle cx="19.0" cy="5.6" r="0.60" /><circle cx="19.8" cy="6.9" r="0.45" /><circle cx="21.0" cy="5.8" r="0.50" /><circle cx="21.4" cy="7.1" r="0.60" /><circle cx="22.5" cy="6.0" r="0.45" /><circle cx="22.6" cy="7.2" r="0.45" /><circle cx="22.9" cy="8.6" r="0.50" /><circle cx="24.4" cy="8.0" r="0.60" /><circle cx="24.3" cy="9.3" r="0.50" /><circle cx="26.2" cy="9.4" r="0.60" /><circle cx="25.7" cy="10.4" r="0.60" /><circle cx="25.2" cy="11.4" r="0.60" /><circle cx="27.1" cy="12.0" r="0.45" /><circle cx="26.3" cy="12.6" r="0.60" /><circle cx="25.7" cy="13.9" r="0.60" /><circle cx="27.3" cy="14.4" r="0.50" /><circle cx="26.5" cy="15.0" r="0.45" /></g></svg>
        <span><b>The asteroids are an approximation.</b> There are over a million out there, and we didn’t draw them all.</span>
      </li>
    </ul>
  </div>
</figure>

<style is:global>
  .orbit-map { margin: 0; }
  .om-stage { position: relative; max-width: 520px; margin: 4px auto 0; }
  .om-svg { display: block; width: 100%; aspect-ratio: 1; }
  .om-actions { position: absolute; right: 4px; bottom: 4px; display: flex; align-items: center; gap: 8px; }
  /* The ? stays 22px like the others; the pill is 2px taller so the two look the same size side by side. */
  .om-actions .help-btn { margin: 0; }
  .om-play {
    box-sizing: border-box; height: 24px; display: flex; align-items: center; gap: 6px;
    font: 500 12px/1 'Jost', sans-serif; color: var(--starlight); background: var(--card);
    border: 1px solid var(--rule); border-radius: 999px; padding: 0 11px 0 10px; cursor: pointer;
  }
  .om-icon { display: block; width: 9px; height: 9px; fill: currentColor; }
  .om-orbit { fill: none; stroke: var(--rule); stroke-width: 0.25; }
  .om-scale-ring { fill: none; stroke: var(--grid); stroke-width: 0.2; stroke-dasharray: 0.6 1; }
  .om-sun { fill: var(--starlight); filter: url(#om-glow); }
  .om-rocks { fill: none; stroke: var(--text-muted); stroke-linecap: round; stroke-width: 0.42; opacity: 0.55; }
  .om-rocks.trojan { stroke: var(--planet-jupiter); opacity: 0.4; }
  .om-sight { stroke: var(--starlight); stroke-width: 0.25; stroke-dasharray: 0.8 0.8; opacity: 0.55; }
  .om-glyph { text-rendering: geometricPrecision; font-size: var(--om-label, 3.6px); font-family: 'Noto Sans Symbols', system-ui, sans-serif; dominant-baseline: central; }
</style>

<script>
  import { BODIES, type Body } from '../lib/orbits';
  import { asteroidPaths, bodyFrame, sightLine } from '../lib/orbit-map';
  import { $focus, $today } from '../lib/store';

  // MapSvg rendered the map at build time; this moves its parts to the focused date. Elements are only updated,
  // never rebuilt: rebuilding ~190 of them every frame made playback judder.
  const DAY = 86_400_000;

  for (const root of document.querySelectorAll<HTMLElement>('.orbit-map')) {
    const one = (sel: string) => root.querySelector(sel)!;
    const set = (e: Element, attrs: Record<string, string | number>) => {
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    };
    const rocksEl = one('[data-om="rocks"]'), trojansEl = one('[data-om="trojans"]');
    const parts = Object.fromEntries(
      BODIES.map((b) => {
        const body = one(`[data-om-body="${b}"]`);
        return [b, {
          grad: one(`[data-om-grad="${b}"]`), tail: one(`[data-om-tail="${b}"]`), sight: one(`[data-om-sight="${b}"]`),
          disc: body.querySelector('[data-om="disc"]')!, shade: body.querySelector('[data-om="shade"]')!,
          label: body.querySelector('text')!, title: body.querySelector('title')!,
        }];
      }),
    ) as Record<Body, Record<'grad' | 'tail' | 'sight' | 'disc' | 'shade' | 'label' | 'title', Element>>;

    // Labels sit on whole device pixels, so text moves in clean 1px steps instead of being re-rounded every frame.
    const mapSvg = root.querySelector<SVGSVGElement>('.om-svg')!;
    let mapWidth = mapSvg.clientWidth; // kept current by the ResizeObserver below
    const snap = (v: number) => {
      const unitsPerPx = 200 / ((mapWidth || 200) * (window.devicePixelRatio || 1));
      return (Math.round(v / unitsPerPx) * unitsPerPx).toFixed(3);
    };

    let now = $today.get().getTime();

    // Asteroids move under 0.6° a day, so during playback they only need redrawing a few times a second.
    let rocksAt = -Infinity;
    function draw() {
      const t = $focus.get() ?? now;
      if (Math.abs(t - rocksAt) >= DAY / 4) {
        const { rocks, trojans } = asteroidPaths(t);
        rocksEl.setAttribute('d', rocks);
        trojansEl.setAttribute('d', trojans);
        rocksAt = t;
      }
      for (const b of BODIES) {
        const { grad, tail, sight, disc, shade, label, title } = parts[b];
        const f = bodyFrame(b, t);
        set(grad, f.grad);
        tail.setAttribute('d', f.tail);
        disc.setAttribute('transform', f.disc);
        shade.setAttribute('transform', f.shade);
        set(label, { x: snap(f.labelX), y: snap(f.y) });
        set(sight, sightLine(b, t));
        title.textContent = f.title;
      }
    }

    // Planet labels stay ~11px on screen whatever the map's size (SVG units shrink on narrow screens).
    new ResizeObserver(([entry]) => {
      mapWidth = entry.contentRect.width;
      const pxPerUnit = mapWidth / 200;
      if (pxPerUnit > 0) mapSvg.style.setProperty('--om-label', `${Math.max(3.6, 11 / pxPerUnit).toFixed(2)}px`);
    }).observe(mapSvg);

    setupPlayback();

    // ▶ Play: moves the shared focus date forward two days per second, so the map, the months chart and the
    // years window all follow. Stops by itself where the years chart ends (5 years ahead, minus half the
    // months window).
    function setupPlayback() {
      const btn = root.querySelector<HTMLButtonElement>('[data-om="play-live"]')!;
      const icon = btn.querySelector('.om-icon path')!;
      const label = btn.querySelector('.om-label')!;
      // SVG shapes rather than ▶/⏸ characters, whose glyphs sit at different heights in the line.
      const PLAY = 'M2.5 1 L9 5 L2.5 9 Z';
      const PAUSE = 'M2 1 H4.2 V9 H2 Z M5.8 1 H8 V9 H5.8 Z';
      const LAST = (60 - 4) * 30.44 * DAY;
      const DAYS_PER_SECOND = 2;
      let frame = 0, last = 0;
      const show = (playing: boolean) => {
        icon.setAttribute('d', playing ? PAUSE : PLAY);
        label.textContent = playing ? 'Pause' : 'Play';
        btn.setAttribute('aria-pressed', String(playing));
        btn.setAttribute('aria-label', playing ? 'Pause' : 'Play: two days per second');
      };
      const stop = () => {
        cancelAnimationFrame(frame);
        frame = 0;
        show(false);
      };
      const step = (ts: number) => {
        const dt = last ? ts - last : 0;
        last = ts;
        const next = ($focus.get() ?? now) + (dt / 1000) * DAYS_PER_SECOND * DAY;
        if (next > now + LAST) return stop();
        $focus.set(next);
        frame = requestAnimationFrame(step);
      };
      // "Back to today" clears the focus: stop rather than carry on from today.
      $focus.listen((v) => {
        if (frame && v === null) stop();
      });
      btn.addEventListener('click', () => {
        if (frame) return stop();
        last = 0;
        show(true);
        frame = requestAnimationFrame(step);
      });
    }
    // Follow the shared "today" (subscribe also fires once now, for the first draw), and the charts' focus
    // while the visitor drags it: at most one redraw per frame.
    $today.subscribe((d) => {
      now = d.getTime();
      draw();
    });
    let pending = false;
    $focus.listen(() => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        pending = false;
        draw();
      });
    });
  }
</script>
