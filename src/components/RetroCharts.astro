---
import { PLANETS, activeAt, nextAfter } from '../lib/retro';
import GlyphKey from './GlyphKey.astro';
import { nextText, nowText } from '../lib/dates';

// Planet notes (src/content/planets/*.md), shown when a glyph in the years chart is tapped.
const notes = Object.values(
  import.meta.glob<{ frontmatter: { planet: string; glyph: string; rules: string; cycle: string }; compiledContent: () => Promise<string> }>(
    '../content/planets/*.md',
    { eager: true },
  ),
);
const notesHtml = await Promise.all(notes.map(async (n) => ({ ...n.frontmatter, html: await n.compiledContent() })));

// Plain-text dates in the static HTML (rebuilt daily) so search engines can read them.
// The page script refreshes them on load, in case the build is stale.
const now = Date.now();
const rows = PLANETS.map((planet) => ({
  planet,
  current: activeAt(planet, now),
  next: nextAfter(planet, now)!,
}));
---

<section>
  <h2>By year <button class="help-btn" type="button" popovertarget="help-years" aria-label="How to read this chart">?</button></h2>
  <div class="help-card" id="help-years" popover>
    <div class="help-head">
      <strong>What am I looking at?</strong>
      <button class="help-close" type="button" popovertarget="help-years" popovertargetaction="hide" aria-label="Close"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M2 2 L12 12 M12 2 L2 12" /></svg></button>
    </div>
    <ul>
      <li>
        <svg class="help-icon" viewBox="0 0 32 18" aria-hidden="true"><path class="i-line" d="M1 16 L7 16 L10 4 L13 13 L16 9 L19 16 L23 16 L26 2 L29 16 L31 16" /></svg>
        <span><b>The top graph</b> counts how many planets are in retrograde at the same time.</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 18" aria-hidden="true"><rect class="i-bar" x="7" y="5" width="18" height="8" rx="2" /></svg>
        <span><b>Each row</b> is one planet. Its bars show when it goes backwards.</span>
      </li>
    </ul>
    <GlyphKey />
  </div>
  <button class="months-reset" id="months-reset" type="button" hidden>Back to today</button>
  <div class="chart" id="chart-years"></div>
  <div class="planet-card" id="planet-card" role="dialog" hidden></div>
  {
    notesHtml.map((n) => (
      <template data-note={n.planet}>
        <header>
          <span class="glyph" style={`color:var(--planet-${n.planet.toLowerCase()})`}>{n.glyph}</span>
          <strong>{n.planet}</strong>
          <span class="card-status" data-status />
        </header>
        <dl>
          <dt>Rules</dt>
          <dd>{n.rules}</dd>
          <dt>Retrograde</dt>
          <dd>{n.cycle}</dd>
        </dl>
        <div class="card-body" set:html={n.html} />
      </template>
    ))
  }
</section>

<section>
  <h2>By month <button class="help-btn" type="button" popovertarget="help-months" aria-label="How to read this chart">?</button></h2>
  <div class="help-card" id="help-months" popover>
    <div class="help-head">
      <strong>What am I looking at?</strong>
      <button class="help-close" type="button" popovertarget="help-months" popovertargetaction="hide" aria-label="Close"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M2 2 L12 12 M12 2 L2 12" /></svg></button>
    </div>
    <ul>
      <li>
        <svg class="help-icon" viewBox="0 0 32 18" aria-hidden="true"><path class="i-wave" d="M1 16 C9 16 11 3 16 3 C21 3 23 16 31 16" /></svg>
        <span><b>Each wave</b> is one planet. While its wave is up, that planet is going backwards.</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 18" aria-hidden="true"><path class="i-wave" d="M1 16 C5 16 6 2 9 2 C12 2 13 16 16 16" /><path class="i-wave i-faint" d="M16 16 C20 16 21 11 24 11 C27 11 28 16 31 16" /></svg>
        <span><b>The height of a wave</b> shows how far back the planet goes, in degrees.</span>
      </li>
      <li>
        <svg class="help-icon" viewBox="0 0 32 32" aria-hidden="true"><g transform="translate(16 16) scale(1.3) translate(-18.5 -9)"><path class="i-horizon" d="M7 15.3 Q18 15 30 15.3" /><path class="i-wedge" d="M12.5 17 L24 15.2 Q27 8 21.5 2.8 Z" /><path class="i-sides" d="M24 15.2 L12.5 17 L21.5 2.8" /><path class="i-path" pathLength="10" d="M24 15.2 Q27 8 21.5 2.8" /><path class="i-arc" d="M19.63 15.88 Q21.49 11.42 18.08 8.2" /><circle class="i-star" cx="24" cy="15.2" r="0.8" /><path class="i-star" d="M21.5 -0.8 L22.55 1.75 L25.1 2.8 L22.55 3.85 L21.5 6.4 L20.45 3.85 L17.9 2.8 L20.45 1.75 Z" /><circle class="i-star" cx="12.5" cy="17" r="1.2" /></g></svg>
        <span><b>A full circle</b> all the way around us is 360°.</span>
      </li>
    </ul>
    <GlyphKey />
  </div>
  <div class="chart" id="chart-months"></div>
</section>

<section class="explainer">
  <h2>What is a retrograde?</h2>
  <p>Planets usually move forward across the night sky. But a few times a year, one seems to stop and <b>walk backwards</b> for a while. That is called a <b>retrograde</b>.</p>
  <p>The planet does not really turn around. It only looks that way from Earth, because we are moving too. It is like passing a slower car on the highway: for a moment, it seems to roll backwards.</p>
  <p>In astrology, a planet going backwards slows down the things it is in charge of. Mercury, for example, is in charge of talking, messages and phones. When <b>several planets go backwards together</b>, life can feel slow and stuck. This page shows you when that happens.</p>
  <GlyphKey interactive />
  <div class="planet-card planet-inline" id="planet-inline" hidden></div>
</section>

<footer class="dates">
  <h2>Retrograde dates</h2>
  <table>
    <thead>
      <tr><th>Planet</th><th>Now</th><th>Next retrograde</th></tr>
    </thead>
    <tbody>
      {
        rows.map(({ planet, current, next }) => (
          <tr data-planet={planet}>
            <th scope="row">{planet}</th>
            <td data-now>{nowText(current)}</td>
            <td data-next>{nextText(next)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</footer>

<script>
  import { renderChart, renderWaves } from '../lib/chart';
  import { $focus, $today } from '../lib/store';
  import { GLYPH, activeAt, nextAfter, type Planet } from '../lib/retro';
  import { fmtDate, nextText, nowText } from '../lib/dates';

  const DAY = 86_400_000;
  // Keeps the time of day, so the months window glides with playback instead of snapping to midnight.
  const addMonths = (t: number, n: number) => {
    const d = new Date(t);
    const midnight = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
    return Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + n, d.getUTCDate()) + (t - midnight);
  };
  const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  const yearsEl = document.getElementById('chart-years')!;
  const monthsEl = document.getElementById('chart-months')!;
  // Chart widths, kept current by the ResizeObserver at the end. Read once here for the first draw.
  const widths = new Map([yearsEl, monthsEl].map((e) => [e, e.clientWidth]));
  // Planets are labelled by glyph; the years chart keeps a narrow column for them,
  // the months chart has no row labels and runs edge to edge.
  const style = { label: (p: Planet) => GLYPH[p], left: 30, hideScale: true, centerLabels: true };
  const monthsStyle = { ...style, left: 0 };

  const MONTHS_EACH_SIDE = 4;
  // A fixed-length window (not calendar months, whose lengths vary and made it jump back at month ends),
  // centred on a whole device pixel: while it slides, each frame moves it 0 or exactly 1 pixel, so lines
  // and glyphs stay crisp instead of shimmering. The months chart runs edge to edge, so its plot width is
  // the container width.
  const HALF_WINDOW = MONTHS_EACH_SIDE * 30.44 * DAY;
  const monthsWindow = (center: number): [number, number] => {
    const px = Math.max(320, widths.get(monthsEl)!) * (window.devicePixelRatio || 1);
    const step = (2 * HALF_WINDOW) / px; // ms per device pixel
    const c = Math.round(center / step) * step;
    return [c - HALF_WINDOW, c + HALF_WINDOW];
  };
  let years: ReturnType<typeof renderChart> | null = null;

  function drawYears() {
    const today = $today.get().getTime();
    years = renderChart(yearsEl, {
      ...style,
      width: widths.get(yearsEl)!,
      from: addMonths(today, -60),
      to: addMonths(today, 60),
      today,
      step: DAY,
      highlight: monthsWindow($focus.get() ?? today),
      onWindowMove: (center) => {
        // Keep the whole window inside the years chart.
        const [from, to] = years!.domain;
        const half = HALF_WINDOW;
        $focus.set(Math.min(Math.max(center, from + half), to - half));
      },
      hoverFormat: (d) => d.toLocaleDateString(undefined, { month: 'long', year: 'numeric', timeZone: 'UTC' }),
      ticks: (from, to) => {
        const values: Date[] = [];
        for (let y = from.getUTCFullYear() + 1; y <= to.getUTCFullYear(); y++) values.push(new Date(Date.UTC(y, 0, 1)));
        const every = widths.get(yearsEl)! < 600 ? 2 : 1;
        return { values, format: (d) => (d.getUTCFullYear() % every ? '' : String(d.getUTCFullYear())) };
      },
    });
  }

  function drawMonths() {
    const today = $today.get().getTime();
    const [monthsFrom, monthsTo] = monthsWindow($focus.get() ?? today);
    years?.setWindow(monthsFrom, monthsTo);
    resetButton.hidden = $focus.get() === null;
    renderWaves(monthsEl, {
      ...monthsStyle,
      width: widths.get(monthsEl)!,
      from: monthsFrom,
      to: monthsTo,
      today,
      hoverFormat: (d) => d.toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }),
      ticks: (from, to) => {
        const values: Date[] = [];
        for (let m = Date.UTC(from.getUTCFullYear(), from.getUTCMonth() + 1, 1); m <= to.getTime(); m = addMonths(m, 1)) values.push(new Date(m));
        return {
          values,
          format: (d) => {
            const m = d.getUTCMonth();
            if (m === 0) return String(d.getUTCFullYear());
            return MONTH_NAMES[m];
          },
        };
      },
    });
  }

  function draw() {
    drawYears();
    drawMonths();
  }

  // Redraw the months chart at most once per frame while dragging.
  let pending = false;
  $focus.listen(() => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => {
      pending = false;
      drawMonths();
    });
  });
  const resetButton = document.getElementById('months-reset') as HTMLButtonElement;
  resetButton.addEventListener('click', () => $focus.set(null));

  // Planet cards: hover a glyph (mouse) or tap it (touch) in the years chart.
  const card = document.getElementById('planet-card')!;
  let cardPlanet: Planet | null = null;
  let pinned = false;
  /** Fills a card element with a planet's note and its current status. */
  function fillCard(el: HTMLElement, planet: Planet) {
    const tpl = document.querySelector<HTMLTemplateElement>(`template[data-note="${planet}"]`);
    if (!tpl) return false;
    el.replaceChildren(tpl.content.cloneNode(true));
    const t = $today.get().getTime();
    const current = activeAt(planet, t);
    el.querySelector('[data-status]')!.textContent = current
      ? `Retrograde until ${fmtDate(current.end)}`
      : `Next: ${fmtDate(nextAfter(planet, t)!.start)}`;
    return true;
  }
  function openCard(planet: Planet, label: SVGGraphicsElement) {
    if (!fillCard(card, planet)) return;
    const box = label.getBoundingClientRect();
    const host = yearsEl.parentElement!.getBoundingClientRect();
    card.style.top = `${box.bottom - host.top + 6}px`;
    card.hidden = false;
    cardPlanet = planet;
  }
  function closeCard() {
    card.hidden = true;
    cardPlanet = null;
    pinned = false;
  }
  // Planet names in the explainer's key show the same card just below the key.
  // Tapping the shown planet again hides it.
  const inlineCard = document.getElementById('planet-inline')!;
  const keyButtons = document.querySelectorAll<HTMLButtonElement>('.key-planet');
  for (const btn of keyButtons) {
    btn.addEventListener('click', () => {
      const planet = btn.dataset.planet as Planet;
      const show = btn.getAttribute('aria-pressed') !== 'true';
      if (show && !fillCard(inlineCard, planet)) return;
      inlineCard.hidden = !show;
      for (const b of keyButtons) b.setAttribute('aria-pressed', String(show && b === btn));
    });
  }
  const labelOf = (e: Event) => (e.target as Element).closest<SVGGraphicsElement>('.row-hit');
  yearsEl.addEventListener('pointerover', (e) => {
    const label = labelOf(e);
    if (label && !pinned && (e as PointerEvent).pointerType === 'mouse') openCard(label.dataset.planet as Planet, label);
  });
  yearsEl.addEventListener('pointerout', (e) => {
    if (labelOf(e) && !pinned && (e as PointerEvent).pointerType === 'mouse') closeCard();
  });
  yearsEl.addEventListener('click', (e) => {
    const label = labelOf(e);
    if (!label) return;
    e.stopPropagation();
    const planet = label.dataset.planet as Planet;
    // Click pins the card. Clicking the pinned planet again closes it.
    if (pinned && cardPlanet === planet) return closeCard();
    openCard(planet, label);
    pinned = true;
  });
  document.addEventListener('click', (e) => {
    if (!card.hidden && !card.contains(e.target as Node)) closeCard();
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeCard());

  function updateTable() {
    const t = $today.get().getTime();
    for (const row of document.querySelectorAll<HTMLTableRowElement>('.dates tr[data-planet]')) {
      const planet = row.dataset.planet as Planet;
      row.querySelector('[data-now]')!.textContent = nowText(activeAt(planet, t));
      row.querySelector('[data-next]')!.textContent = nextText(nextAfter(planet, t)!);
    }
  }

  $today.subscribe(() => {
    draw();
    updateTable();
  });
  // Redraw when either chart's width changes. A ResizeObserver reports sizes after layout, so drawing (every frame
  // during ▶ Play) never has to measure the page itself.
  const ro = new ResizeObserver((entries) => {
    let changed = false;
    for (const e of entries) {
      const w = Math.round(e.contentRect.width); // whole px, like clientWidth
      if (w !== widths.get(e.target as HTMLElement)) {
        widths.set(e.target as HTMLElement, w);
        changed = true;
      }
    }
    if (changed) draw();
  });
  ro.observe(yearsEl);
  ro.observe(monthsEl);
</script>

