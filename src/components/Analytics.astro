---
// GoatCounter: cookieless, no consent banner needed.
// Set this to your site code (the "CODE" in CODE.goatcounter.com).
const GOATCOUNTER_CODE = 'kutnerism';
const enabled = GOATCOUNTER_CODE && import.meta.env.PROD;
---

{enabled && (
  <Fragment>
    {/* Prefix paths with the hostname so one GoatCounter site can track several domains. */}
    <script is:inline>
      window.goatcounter = { path: (p) => location.hostname + p };
    </script>
    <script
      is:inline
      data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
      async
      src="https://gc.zgo.at/count.js"
    ></script>
  </Fragment>
)}
